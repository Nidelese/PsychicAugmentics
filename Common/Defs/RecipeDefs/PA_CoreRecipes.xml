<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Cores seat near the heart. Crafting recipes come from each core
       ThingDef's recipeMaker; these are surgery only. -->
  <RecipeDef Name="PA_InstallCoreBase" ParentName="SurgeryInstallImplantBase" Abstract="True">
    <appliedOnFixedBodyParts>
      <li>Heart</li>
    </appliedOnFixedBodyParts>
    <!-- Seating a psychically active sphere beside the heart: riskier than
         a standard implant. Skill floor stays vanilla (5); the danger comes
         from setup quality, like all RimWorld surgery. -->
    <surgerySuccessChanceFactor>0.9</surgerySuccessChanceFactor>
  </RecipeDef>

  <RecipeDef Name="PA_RemoveCoreBase" ParentName="SurgeryRemoveImplantBase" Abstract="True">
    <appliedOnFixedBodyParts>
      <li>Heart</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

  <RecipeDef ParentName="PA_InstallCoreBase">
    <defName>PA_InstallCoreTox</defName>
    <label>install tox core</label>
    <description>Seat a tox core beside the patient's heart.</description>
    <jobString>Installing tox core.</jobString>
    <ingredients>
      <li>
        <filter><thingDefs><li>PA_CoreTox</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>PA_CoreTox</li></thingDefs></fixedIngredientFilter>
    <addsHediff>PA_Hediff_CoreTox</addsHediff>
    <uiIconThing>PA_CoreTox</uiIconThing>
  </RecipeDef>
  <RecipeDef ParentName="PA_RemoveCoreBase">
    <defName>PA_RemoveCoreTox</defName>
    <label>remove tox core</label>
    <description>Extract the tox core.</description>
    <jobString>Removing tox core.</jobString>
    <removesHediff>PA_Hediff_CoreTox</removesHediff>
    <uiIconThing>PA_CoreTox</uiIconThing>
  </RecipeDef>

